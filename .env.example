# Local compose database user.
POSTGRES_USER=app

# Local compose database password. Use non-secret local value only.
POSTGRES_PASSWORD=app_secret

# Local compose database name.
POSTGRES_DB=app

# Backend database URL. Runtime injects this in deployment.
DATABASE_URL=postgres://app:app_secret@postgres:5432/app?sslmode=disable

# Backend HTTP port.
PORT=8080

# Frontend browser-facing API URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional local host ports.
BACKEND_PORT=8080
FRONTEND_PORT=3000
